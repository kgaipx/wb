[Unit]
Description=GWY AI Tutor Backend (uvicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/gwy/backend
Environment=PYTHONUNBUFFERED=1
Environment=DATABASE_URL=sqlite:////opt/gwy/data/gwy.db
# 多 worker 提升并发；SQLite 已开 WAL + check_same_thread=False 支撑多进程读写
ExecStart=/opt/gwy/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 3
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
