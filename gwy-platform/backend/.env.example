# ============ 应用 ============
APP_NAME="AI公务员考前培训学习平台"
APP_ENV=development
SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ 数据库 ============
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=gwy
MYSQL_PASSWORD=gwy_dev_pass
MYSQL_DATABASE=gwy_platform
# 完整 URL（优先于上面的分段配置）
DATABASE_URL=mysql+pymysql://gwy:gwy_dev_pass@127.0.0.1:3306/gwy_platform?charset=utf8mb4

# ============ Redis ============
REDIS_URL=redis://127.0.0.1:6379/0

# ============ LLM（国内合规大模型，OpenAI 兼容协议） ============
# 例如混元 / 通义 / 智谱 等，需提前申请企业资质与 API Key
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.your-llm-provider.com/v1
LLM_MODEL=your-model-name
LLM_FALLBACK_MODEL=your-fallback-model

# ============ 向量库 ============
VECTOR_DB_URL=http://127.0.0.1:19530
EMBEDDING_MODEL=your-embedding-model

# ============ 支付 / 短信（商业化阶段，提前申请商户号） ============
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=

# ============ CORS ============
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
