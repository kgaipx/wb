# ============ 应用 ============
APP_NAME="AI公务员考前培训学习平台"
# development / test / production
APP_ENV=development
SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ 数据库 ============
# 默认 SQLite（零外部依赖，开箱即用，本地验证 / 生产均可用 WAL 模式）：
DATABASE_URL=sqlite:///./gwy_dev.db
# 进阶 / 规模化：MySQL（需先启动 MySQL，或用 docker-compose up -d mysql 起依赖）：
# DATABASE_URL=mysql+pymysql://gwy:gwy_dev_pass@127.0.0.1:3306/gwy_platform?charset=utf8mb4

# ============ Redis（可选） ============
# 当前限流为进程内计数；接入 Redis 后可实现多 worker 全局精确限流。未配置不影响运行。
REDIS_URL=redis://127.0.0.1:6379/0

# ============ LLM（国内合规大模型，OpenAI 兼容协议） ============
# 例如混元 / 通义 / 智谱 / DeepSeek 等，需提前申请企业资质与 API Key
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.your-llm-provider.com/v1
LLM_MODEL=your-model-name
LLM_FALLBACK_MODEL=your-fallback-model

# ============ 向量库（可选，RAG 检索增强） ============
VECTOR_DB_URL=http://127.0.0.1:19530
EMBEDDING_MODEL=your-embedding-model

# ============ 支付 / 短信（商业化阶段，提前申请商户号） ============
# 沙箱模式：自托管 / 演示用，可模拟支付回调；接真实微信 / 支付宝时置 false
PAYMENT_SANDBOX=true
PAYMENT_NOTIFY_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=

# ============ 邮件（账号找回） ============
# 未配置 SMTP_HOST 时进入开发模式，/auth/forgot-password 直接返回重置令牌，便于自托管演示
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=noreply@gwy.example

# ============ CORS ============
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
